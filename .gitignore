# Dependencies & build output
node_modules/
dist/
coverage/

# Logs
*.log
logs/

# OS / editor
.DS_Store
.idea/
# .vscode/ has tracked launch.json + tasks.json (shared debug config).
# Ignore only the per-user files commonly written by VS Code.
.vscode/settings.json
.vscode/*.code-workspace
.history/

# Secrets — all dotenv variants. If you ever add an .env.example template,
# add `!.env.example` below to allow-list it.
.env
.env.*

# Plugin-local state (e.g. ralph-loop session files)
.claude/*.local.md

# KAIROS runtime artifacts — per-machine state, never tracked.
# Note: auto-mem lives under ~/.claude/projects/<encoded-cwd>/memory/ (outside
# the repo), so .consolidate-lock doesn't need a rule here.
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.claude/loop.md

# Python bytecode
__pycache__/
*.pyc

# Root-only screenshots — subdirectory PNGs may be tracked assets
/*.png
*.bmp

# bun-demincer/ — vendored fork (folded 2026-05-09 from Icarus603/bun-demincer).
# The directory itself is tracked; only its per-machine runtime artefacts are
# excluded. See bun-demincer/.gitignore for the inner rules (work/, deltas/,
# reports/, runs.log, .launchd-*.log, .update.lockdir/, etc.).

# Rust / cargo build artifacts
# packages/ripgrep-napi/.cargo/config.toml redirects target-dir here so
# packages/ stays clean (verify-empty-folders trips on cargo's transient
# empty subdirs).
/target/
