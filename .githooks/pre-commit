#!/bin/sh
# pre-commit hook:
#   1. Biome lint on staged packages/ + scripts/ files
#   2. Fast doctor:arch subset — rules that matter for staged
#      changes and complete in <2s. Full doctor:arch suite (78
#      rules as of 2026-05-04) runs in pre-push and CI.
#
# Skip with PRE_COMMIT_SKIP=1 when you really need to commit something
# the hook doesn't understand (rare; prefer fixing the underlying issue).

if [ "$PRE_COMMIT_SKIP" = "1" ]; then
  echo "PRE_COMMIT_SKIP=1: bypassing pre-commit checks"
  exit 0
fi

# V7 §11.2: source lives under packages/ (no src/ since the V7
# refactor). The glob accepts both packages/ and scripts/ (verifier
# tooling). Pre-V7 versions of this hook used `^src/.*` which never
# matched anything after V7 — silently disabling staged-file lint
# for the entire post-V7 lifetime, until 2026-05-04.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(packages|scripts)/.*\.(ts|tsx)$')

if [ -n "$STAGED_FILES" ]; then
  echo "Running Biome lint on staged files..."
  echo "$STAGED_FILES" | xargs bunx biome lint --no-errors-on-unmatched
  if [ $? -ne 0 ]; then
    echo ""
    echo "Biome lint failed. Fix errors or use PRE_COMMIT_SKIP=1 to bypass."
    exit 1
  fi
fi

# Fast doctor checks: ratchet-style rules that catch the most common
# regressions (LOC growth, missing exports, broken imports, naming
# violations). Each verifier runs in <500ms.
echo "Running fast doctor:arch checks..."
# Only fast verifiers (<500ms each) here; the slower full-grep ones
# (deps-setters-wired, await-generator-misuse, dual-storage-divergence,
# silent-failure-ratchet) run in pre-push instead.
for check in \
  scripts/verify-replview-shrinks.ts \
  scripts/verify-src-shrinks.ts \
  scripts/verify-package-exports.ts \
  scripts/verify-package-private-src.ts \
  scripts/verify-no-holding-pens.ts \
  scripts/verify-package-readme.ts \
  scripts/verify-feature-canonical.ts \
  scripts/verify-facade-budget.ts \
  scripts/verify-build-resolves.ts \
  scripts/verify-host-binding-completeness.ts; do
  bun run "$check" >/dev/null 2>&1
  if [ $? -ne 0 ]; then
    echo ""
    echo "doctor check failed: $check"
    echo "Run 'bun run scripts/doctor-architecture.ts' for details."
    echo "Bypass with PRE_COMMIT_SKIP=1 only if absolutely necessary."
    exit 1
  fi
done

exit 0
